# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
*.egg-info/

# Data and models are versioned with DVC, not Git. DVC writes its own .gitignore entries
# for each tracked output, so they are not listed here.
# The TFDS download cache is not tracked at all: the exported data/raw is.
/data/tfds/

# MLflow local stores
mlruns/
mlartifacts/
mlflow.db

# Airflow runtime files
airflow/logs/
airflow/*.db
airflow/*.pid
airflow/airflow.cfg
airflow/webserver_config.py

# Ray session files
/tmp/ray/

# Editors and OS
.vscode/
.idea/
.DS_Store
.env
*.log

# local backend feedback store (snapshotted into DVC by the retraining DAG)
/feedback/*
!/feedback/.gitkeep
airflow/db/
.coverage
